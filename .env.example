# Example environment file for MERLIN. Copy to .env, fill in real values,
# and keep .env out of version control (.gitignore already covers it).
#
# NOTE: this project does not auto-load .env files. It reads real Windows
# environment variables, so the recommended setup is:
#
#     setx GEMINI_API_KEY "your-key-here"
#     setx NEWS_API_KEY "your-key-here"
#
# then open a NEW terminal before running MERLIN.

# Required for Gemini questions.
GEMINI_API_KEY=

# Required only for the "news" command.
NEWS_API_KEY=

# AI provider for chat. Seeds the Settings → AI provider choice on a fresh
# install; use Settings afterwards to change it at runtime.
#   auto    - Gemini when GEMINI_API_KEY is configured; otherwise MERLIN
#             honestly reports what is missing
#   mock    - development mode: offline, deterministic placeholder answers,
#             clearly marked as NOT coming from Gemini. No key needed.
#   gemini  - always use Gemini (requires the key above)
# MERLIN_PROVIDER=auto

# Optional overrides.
# GEMINI_MODEL=gemini-2.5-flash
# NEWS_COUNTRY=in
# NEWS_QUERY=india OR travel

# Microphone / device selection.
# MIC_DEVICE_INDEX=7
# MIC_MIN_RMS=20
# MIC_PROBE_LIMIT=6
# MIC_PROBE_SECONDS=2
# MIC_RESELECT_AFTER=5

# Microphone liveness thresholds. Raise/lower only if you understand what
# they reject: MERLIN discards an input that looks like digital silence or
# discontinuous noise instead of feeding it to the recogniser.
# MIC_MAX_ZERO_FRACTION=0.4
# MIC_MIN_CONTINUITY=0.5